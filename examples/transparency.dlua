function update()
    cls(0)                          -- фон: цвет 0 (светлый)

    -- Тёмный залитый прямоугольник
    rect(20, 20, 56, 56, 1)         -- цвет 1 (тёмный)

    -- Спрайт ПОВЕРХ тёмного прямоугольника
    spr(0, 44, 44)

    print("IF YOU SEE LIGHT", 0, 0)
    print("SQUARES ON DARK", 0, 6)
    print("TRANSPARENCY OK", 0, 12)
end