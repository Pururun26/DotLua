--[[utils.lua]]
--[[player.lua]]

t = 0

function update()
    t = t + 1

    cls(0)

    for i = 0, 95 do
        pset(i, 0,  1)
        pset(i, 95, 1)
        pset(0,  i, 1)
        pset(95, i, 1)
    end

    player_update()
    player_draw()

    if (t // 15) % 2 == 0 then
        pset(3, 3, 1)
    end
end