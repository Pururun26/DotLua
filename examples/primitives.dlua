function update()
    cls(0)

    -- прямоугольник на весь экран минус рамка
    rect(2, 2, 92, 92, 1)

    -- "вырезаем" фон в центре
    rect(6, 6, 84, 84, 0)

    -- линии по диагоналям
    line(6, 6, 89, 89, 1)
    line(89, 6, 6, 89, 1)

    -- овал (эллипс)
    oval(20, 10, 56, 20, 1)

    -- круг (w == h)
    oval(36, 36, 24, 24, 1)

    -- "дырка" в круге
    oval(42, 42, 12, 12, 0)

    -- текст
    print("DOTLUA", 30, 80)
end