math.randomseed(utime())
print("seed =", utime())

px, py = 48, 48
r = 3

stars = {}
for i = 1, 30 do
    stars[i] = { x = math.random(0, 95), y = math.random(0, 95) }
end

function update()
    if btn(0) then px = px - 1 end
    if btn(1) then px = px + 1 end
    if btn(2) then py = py - 1 end
    if btn(3) then py = py + 1 end

    if px < r      then px = r      end
    if px > 95 - r then px = 95 - r end
    if py < r      then py = r      end
    if py > 95 - r then py = 95 - r end

    if btnp(4) then   -- A: перебросить звёзды
        for i = 1, #stars do
            stars[i].x = math.random(0, 95)
            stars[i].y = math.random(0, 95)
        end
    end

    cls(0)
    for i = 1, #stars do pset(stars[i].x, stars[i].y, 1) end

    oval(px - r, py - r, r * 2, r * 2, 1)

    print("WASD/ARROWS: MOVE", 0, 0)
    print("Z/J: REROLL", 0, 6)
end